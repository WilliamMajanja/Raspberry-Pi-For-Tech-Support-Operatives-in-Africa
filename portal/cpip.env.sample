# CPIP server is an internal crypto/encoding backend, never a public web origin.
CPIP_DEVICE=hyper-text
CPIP_BIND=127.0.0.1
CPIP_PORT=4180
CPIP_SSL=0
CPIP_SSL_AUTO=0
CPIP_HTTP_REDIRECT=0
CPIP_RPC_AUTH=1
CPIP_MESH=0
CPIP_RADIO=0
CPIP_SAT=0
CPIP_MOBILE=0
CPIP_AVAHI=0
CPIP_NTP=0
CPIP_PROVIDER_DNS=0
CPIP_PROVIDER_MESH=0
CPIP_COVERT=1
CPIP_COVER_TRAFFIC=0
# Replace with the same protected random value used in portal.env.sample.
CPIP_COVERT_KEY=REPLACE_WITH_PROTECTED_RANDOM_SECRET
