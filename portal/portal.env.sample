CPIP_INTERNAL_ORIGIN=http://127.0.0.1:4180
# Must match CPIP_COVERT_KEY in cpip.env.sample; store outside the repository.
CPIP_COVERT_KEY=REPLACE_WITH_THE_SAME_PROTECTED_CPIP_SECRET
# Independent portal token pepper; store outside the repository.
CPIP_BOOK_TOKEN_PEPPER=REPLACE_WITH_A_DIFFERENT_PROTECTED_RANDOM_SECRET
# SHA-256 of the public starter answer FLAG{WRITTEN_SCOPE}; this is a puzzle check, not a secret.
CPIP_BOOK_STARTER_ANSWER_SHA256=9fee780b6f0e90074e3f0dedc23ffb9a49683192be83312803eb750ba5c55664
CPIP_BOOK_DATA_DIR=/var/lib/cpip-book-portal
CPIP_BOOK_APP_DIR=/var/lib/cpip-book-portal/apps
CPIP_BOOK_PORTAL_PORT=4310
CPIP_BOOK_DOMAIN=downloads.example.org
